# Copy this file to .env (or set these as real environment variables) before running the app.

# PostgreSQL connection string. If unset, the app falls back to a local
# SQLite file (business_analytics.db) for development.
DATABASE_URL=postgresql://user:password@localhost:5432/business_analytics

# Secret used for session signing. Set this to a long random value in production.
SESSION_SECRET=change-me-to-a-random-secret

# Where trained model files (.pkl) are stored on disk.
MODEL_DIR=models

# Credentials shown as a hint on the login screen (demo/dev only).
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo123

# ML training thresholds.
MIN_TRAINING_DAYS=7
MIN_TRAINING_POSTS=3
PREDICTION_EVAL_WINDOW_DAYS=3
